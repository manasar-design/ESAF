              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <assertionsResultsToSave>0</assertionsResultsToSave>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import javax.crypto.spec.GCMParameterSpec
import java.util.Base64

// ============================================
// CONFIGURATION (Match your Python code)
// ============================================
def SECRET_KEY = &quot;JSgFznpEFHQec+lDTOTgpXDdtorGzuyc&quot;
def NONCE      = &quot;123123123123&quot;  // 12 bytes FIXED nonce
def GCM_TAG_LENGTH = 128  // bits

// ============================================
// GET VARIABLES FROM CSV
// ============================================
def email    = vars.get(&quot;username&quot;)
def password = vars.get(&quot;password&quot;)

// ============================================
// BUILD JSON PAYLOAD
// ============================================
def jsonPayload = &quot;&quot;&quot;{&quot;email&quot;:&quot;${email}&quot;,&quot;password&quot;:&quot;${password}&quot;,&quot;verify_two_factor_otp&quot;:false,&quot;otp&quot;:&quot;123456&quot;}&quot;&quot;&quot;
log.info(&quot;Original payload: &quot; + jsonPayload)

// ============================================
// ENCRYPT USING AES GCM
// ============================================
def keyBytes = SECRET_KEY.getBytes(&quot;UTF-8&quot;)
def key = new SecretKeySpec(keyBytes, &quot;AES&quot;)
def iv  = NONCE.getBytes(&quot;UTF-8&quot;)

Cipher cipher = Cipher.getInstance(&quot;AES/GCM/NoPadding&quot;)
GCMParameterSpec spec = new GCMParameterSpec(GCM_TAG_LENGTH, iv)
cipher.init(Cipher.ENCRYPT_MODE, key, spec)
byte[] cipherOutput = cipher.doFinal(jsonPayload.getBytes(&quot;UTF-8&quot;))

// In Java, GCM output is ciphertext + tag (16 bytes) combined
// This matches Python: base64.b64encode(ciphertext + tag)
String encryptedBase64 = Base64.getEncoder().encodeToString(cipherOutput)
log.info(&quot;Encrypted payload: &quot; + encryptedBase64)

// Store for use in HTTP Request
vars.put(&quot;encryptedPayload&quot;, encryptedBase64)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import javax.crypto.spec.GCMParameterSpec
import java.util.Base64

// ============================================
// CONFIGURATION
// ============================================
def SECRET_KEY = &quot;JSgFznpEFHQec+lDTOTgpXDdtorGzuyc&quot;
def NONCE      = &quot;123123123123&quot;
def GCM_TAG_LENGTH = 128

// ============================================
// GET ENCRYPTED RESPONSE
// ============================================
def encryptedResponse = prev.getResponseDataAsString()
log.info(&quot;Encrypted response: &quot; + encryptedResponse)

if (encryptedResponse == null || encryptedResponse.isEmpty()) {
    log.warn(&quot;No response to decrypt&quot;)
    return
}

// ============================================
// DECRYPT
// ============================================
def keyBytes = SECRET_KEY.getBytes(&quot;UTF-8&quot;)
def key = new SecretKeySpec(keyBytes, &quot;AES&quot;)
def iv  = NONCE.getBytes(&quot;UTF-8&quot;)

// Decode from Base64
byte[] encryptedBytes = Base64.getDecoder().decode(encryptedResponse)

// Separate ciphertext and tag (last 16 bytes)
byte[] ciphertext = new byte[encryptedBytes.length - 16]
byte[] tag        = new byte[16]
System.arraycopy(encryptedBytes, 0, ciphertext, 0, ciphertext.length)
System.arraycopy(encryptedBytes, ciphertext.length, tag, 0, 16)

// Java&apos;s GCM expects ciphertext + tag together for decryption
byte[] cipherInput = new byte[ciphertext.length + tag.length]
System.arraycopy(ciphertext, 0, cipherInput, 0, ciphertext.length)
System.arraycopy(tag, 0, cipherInput, ciphertext.length, tag.length)

// Decrypt
Cipher cipher = Cipher.getInstance(&quot;AES/GCM/NoPadding&quot;)
GCMParameterSpec spec = new GCMParameterSpec(GCM_TAG_LENGTH, iv)
cipher.init(Cipher.DECRYPT_MODE, key, spec)
byte[] plainBytes = cipher.doFinal(cipherInput)

String decrypted = new String(plainBytes, &quot;UTF-8&quot;)
log.info(&quot;Decrypted response: &quot; + decrypted)

// Store decrypted response
vars.put(&quot;decryptedResponse&quot;, decrypted)

// Update response data in JMeter (optional)
prev.setResponseData(decrypted.getBytes(&quot;UTF-8&quot;))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PostProcessor>
